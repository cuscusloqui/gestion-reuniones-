{
  "info": {
    "_postman_id": "b6a2a4b0-2f7a-4a3f-9a4a-5f6d3c0e2a11",
    "name": "Gestion de Reuniones - API REST",
    "description": "Coleccion para consumir la API REST de la app de gestion de reuniones (local, sin autenticacion). Usa la variable {{baseUrl}} (por defecto http://localhost:8080). Al ejecutar 'Crear reunion' se guarda automaticamente el id devuelto en la variable de coleccion {{reunionId}}, que usan el resto de peticiones. 'intervinientes' es una lista de nombres (array JSON): en cada PUT se envia la lista completa deseada (añadir un nombre = incluirlo en el array; quitarlo = omitirlo).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "reunionId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Crear reunion",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "    const body = pm.response.json();",
              "    pm.collectionVariables.set('reunionId', body.id);",
              "    console.log('reunionId guardado:', body.id);",
              "}",
              "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
              "pm.test('Devuelve Location', () => pm.response.headers.has('Location'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Reunion de arquitectura\",\n  \"fechaInicio\": \"2026-09-20T09:00:00Z\",\n  \"fechaFin\": \"2026-09-20T10:00:00Z\",\n  \"intervinientes\": [\"Carlos\", \"Ana\"],\n  \"contenidoHtml\": \"<p>Puntos a tratar: <strong>diseño de la API</strong></p>\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/reuniones",
          "host": ["{{baseUrl}}"],
          "path": ["api", "reuniones"]
        }
      }
    },
    {
      "name": "Obtener detalle de reunion",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/reuniones/{{reunionId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "reuniones", "{{reunionId}}"]
        }
      }
    },
    {
      "name": "Obtener contenido en texto plano",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/reuniones/{{reunionId}}/contenido-texto",
          "host": ["{{baseUrl}}"],
          "path": ["api", "reuniones", "{{reunionId}}", "contenido-texto"]
        }
      }
    },
    {
      "name": "Actualizar reunion (quita a Ana, añade a Luis)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Reunion de arquitectura (revisada)\",\n  \"fechaInicio\": \"2026-09-20T09:00:00Z\",\n  \"fechaFin\": \"2026-09-20T10:30:00Z\",\n  \"intervinientes\": [\"Carlos\", \"Luis\"],\n  \"contenidoHtml\": \"<p>Contenido actualizado</p>\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/reuniones/{{reunionId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "reuniones", "{{reunionId}}"]
        }
      }
    },
    {
      "name": "Listar reuniones (sin filtros)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/reuniones?page=0&size=20&sort=fechaInicio,desc",
          "host": ["{{baseUrl}}"],
          "path": ["api", "reuniones"],
          "query": [
            { "key": "page", "value": "0" },
            { "key": "size", "value": "20" },
            { "key": "sort", "value": "fechaInicio,desc" }
          ]
        }
      }
    },
    {
      "name": "Listar reuniones - filtros combinados",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/reuniones?titulo=arquitectura&desde=2026-09-01T00:00:00Z&hasta=2026-09-30T23:59:59Z&page=0&size=10",
          "host": ["{{baseUrl}}"],
          "path": ["api", "reuniones"],
          "query": [
            { "key": "titulo", "value": "arquitectura" },
            { "key": "desde", "value": "2026-09-01T00:00:00Z" },
            { "key": "hasta", "value": "2026-09-30T23:59:59Z" },
            { "key": "contenido", "value": "", "disabled": true },
            { "key": "interviniente", "value": "", "disabled": true },
            { "key": "q", "value": "", "disabled": true },
            { "key": "page", "value": "0" },
            { "key": "size", "value": "10" }
          ]
        }
      }
    },
    {
      "name": "Listar reuniones - busqueda global (q)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/reuniones?q=presupuesto",
          "host": ["{{baseUrl}}"],
          "path": ["api", "reuniones"],
          "query": [
            { "key": "q", "value": "presupuesto" }
          ]
        }
      }
    },
    {
      "name": "Reuniones por rango (calendario)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/reuniones/rango?desde=2026-09-01T00:00:00Z&hasta=2026-09-30T23:59:59Z",
          "host": ["{{baseUrl}}"],
          "path": ["api", "reuniones", "rango"],
          "query": [
            { "key": "desde", "value": "2026-09-01T00:00:00Z" },
            { "key": "hasta", "value": "2026-09-30T23:59:59Z" }
          ]
        }
      }
    },
    {
      "name": "Eliminar reunion",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 204 No Content', () => pm.response.to.have.status(204));",
              "if (pm.response.code === 204) {",
              "    pm.collectionVariables.set('reunionId', '');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/reuniones/{{reunionId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "reuniones", "{{reunionId}}"]
        }
      }
    }
  ]
}
